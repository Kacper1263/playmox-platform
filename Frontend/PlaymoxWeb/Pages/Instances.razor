    private Color GetQuotaColor(int used, int limit)
    {
        double ratio = limit > 0 ? (double)used / limit : 0;
        if (ratio > 0.9) return Color.Error;
        if (ratio > 0.7) return Color.Warning;
        return Color.Primary;
    }

