    private void RecalculateUsage()
    {
        var active = instances.Where(x => !string.Equals(x.Status, "Deleted", StringComparison.OrdinalIgnoreCase)).ToList();
        var computeStatuses = new[] { "Creating", "Running", "Updating" };
        var computeInstances = active.Where(x => computeStatuses.Contains(x.Status, StringComparer.OrdinalIgnoreCase)).ToList();

        activeInstancesCount = computeInstances.Count;
        usedCpu = computeInstances.Sum(x => x.CpuCores);
        usedMemoryMb = computeInstances.Sum(x => x.MemoryMb);
        usedDiskGb = active.Sum(x => x.DiskGb ?? 0);
        usedPublicPorts = computeInstances.Sum(x => x.GamePublicPortCount ?? 0);
    }

    private static string FormatBytes(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return "0 B";
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        int suffixIndex = 0;
        double value = bytes.Value;
        while (value >= 1024 && suffixIndex < suffixes.Length - 1)
        {
            value /= 1024;
            suffixIndex++;
        }
        return $"{value:0.#} {suffixes[suffixIndex]}";
    }

