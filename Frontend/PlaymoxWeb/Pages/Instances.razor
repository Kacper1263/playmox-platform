    private async Task OpenSshPreviewAsync(long instanceId, bool enableSshTerminal)
    {
        CloseSshPreview();
        sshTerminalEnabled = enableSshTerminal;
        sshPreviewInstanceId = instanceId;
        _sshPreviewOpen = true;
        StateHasChanged();
        
        apiCommandStreamCts = new CancellationTokenSource();
        _ = PollApiCommandStreamAsync(instanceId, apiCommandStreamCts.Token);
        
        if (sshTerminalEnabled)
        {
            sshPreviewOutput = L.T(Tr.Instances.SshConnecting);
            sshPreviewMessage = L.T(Tr.Instances.SshConnecting);
            sshPreviewSeverity = Severity.Info;
            var token = await AuthStateService.GetValidAccessTokenAsync(TimeSpan.FromMinutes(1));
            if (string.IsNullOrWhiteSpace(token))
            {
                sshPreviewMessage = L.T(Tr.Instances.SshSessionFailed);
                sshPreviewSeverity = Severity.Error;
                StateHasChanged();
                return;
            }

            sshDotNetRef = DotNetObjectReference.Create(this);
            var path = $"/api/ws/instances/{instanceId}/ssh?access_token={Uri.EscapeDataString(token!)}";
            await JsRuntime.InvokeVoidAsync("playmoxSsh.connect", path, sshDotNetRef);
        }
    }

    private void CloseSshPreview()
    {
        apiCommandStreamCts?.Cancel();
        _ = JsRuntime.InvokeVoidAsync("playmoxSsh.close");
        sshDotNetRef?.Dispose();
        _sshPreviewOpen = false;
        StateHasChanged();
    }

    private async Task PollApiCommandStreamAsync(long instanceId, CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var snapshot = await ApiClient.GetJsonAsync<LiveCommandStreamItem>($"api/instances/{instanceId}/live-command-stream");
            if (snapshot != null)
            {
                apiCommandStreamMessage = snapshot.Active
                    ? L.T(Tr.Instances.StreamActive, snapshot.CommandSummary)
                    : L.T(Tr.Instances.StreamNoActiveOperation);
                var formattedItems = snapshot.RecentItems.Select(i =>
                {
                    var sb = new System.Text.StringBuilder();
                    var timeStr = i.StartedAtUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "---";
                    sb.AppendLine($"[{timeStr}] --- START: {i.CommandSummary} (PID: {i.Pid}) ---");
                    if (!string.IsNullOrEmpty(i.Output)) sb.AppendLine(i.Output);
                    if (!i.Active)
                    {
                        var endTimeStr = i.CompletedAtUtc?.ToLocalTime().ToString("HH:mm:ss") ?? "---";
                        sb.AppendLine($"[{endTimeStr}] --- END: {i.CommandSummary} (Exit Code: {i.ExitCode}) ---");
                    }
                    return sb.ToString();
                });
                apiCommandStreamOutput = string.Join("\n", formattedItems).StripAnsiEscapeCodes();
                StateHasChanged();
                if (apiStreamAutoScroll) await JsRuntime.InvokeVoidAsync("playmoxSsh.scrollToBottom", "api-command-console");
            }
            await Task.Delay(2000, ct);
        }
    }

    [JSInvokable] public async Task OnSshWsMessage(string chunk) 
    { 
        var stripped = chunk.StripAnsiEscapeCodes(); 
        foreach (var c in stripped)
        {
            if (c == '\b' || c == '\x7f')
            {
                if (sshPreviewOutput.Length > 0) sshPreviewOutput = sshPreviewOutput[..^1];
            }
            else
            {
                sshPreviewOutput += c;
            }
        }
        StateHasChanged(); 
        if (sshAutoScroll) await JsRuntime.InvokeVoidAsync("playmoxSsh.scrollToBottom", "ssh-terminal-console");
    }
    
