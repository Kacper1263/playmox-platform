    private async Task RefreshInstancesOnlyAsync()
    {
        var instancesTask = ApiClient.GetJsonAsync<List<InstanceListItem>>("api/instances");
        Task<AdminProxmoxDashboardDto?>? adminTask = null;
        if (AuthStateService.IsAdmin())
        {
            adminTask = ApiClient.GetJsonAsync<AdminProxmoxDashboardDto>("api/admin/proxmox-dashboard");
        }

        if (adminTask != null)
        {
            await Task.WhenAll(instancesTask, adminTask);
            adminDashboard = adminTask.Result;
        }
        else
        {
            await instancesTask;
        }

        instances = instancesTask.Result ?? [];
        var currentIds = instances.Select(x => x.Id).ToHashSet();
        _openActionsMenuInstanceIds.RemoveWhere(id => !currentIds.Contains(id));
        RecalculateUsage();
        StateHasChanged();
    }

