    private async Task OnTerminalKeyDown(KeyboardEventArgs e)
    {
        string? payload = null;

        if (e.CtrlKey)
        {
            payload = e.Key.ToLowerInvariant() switch
            {
                "c" => "\x03",
                "d" => "\x04",
                "l" => "\x0c",
                "z" => "\x1a",
                _ => null
            };
        }
        else
        {
            payload = e.Key switch
            {
                "Enter" => "\r",
                "Backspace" => "\u007f",
                "Tab" => "\t",
                "Escape" => "\x1b",
                "ArrowUp" => "\x1b[A",
                "ArrowDown" => "\x1b[B",
                "ArrowRight" => "\x1b[C",
                "ArrowLeft" => "\x1b[D",
                _ => e.Key.Length == 1 ? e.Key : null
            };
        }

        if (payload != null) 
        {
            var sent = await JsRuntime.InvokeAsync<bool>("playmoxSsh.send", payload);
            if (!sent)
            {
                sshPreviewMessage = L.T(Tr.Instances.SshTerminalDisconnected);
                sshPreviewSeverity = Severity.Error;
                StateHasChanged();
            }
        }
    }

