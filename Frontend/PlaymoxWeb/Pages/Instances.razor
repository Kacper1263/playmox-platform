    private IReadOnlyDictionary<string, object> GetTutorialAttributes(InstanceListItem item, string id)
    {
        if (!isTutorialActive || tutorialPrimaryInstanceId != item.Id)
        {
            return EmptyAttributes;
        }

        return new Dictionary<string, object> { ["id"] = id };
    }

    private void RecalculateTutorialUsage()
    {
        var active = tutorialInstances.Where(x => !string.Equals(x.Status, "Deleted", StringComparison.OrdinalIgnoreCase)).ToList();
        var computeStatuses = new[] { "Creating", "Running", "Updating" };
        var computeInstances = active.Where(x => computeStatuses.Contains(x.Status, StringComparer.OrdinalIgnoreCase)).ToList();

        tutorialActiveInstancesCount = computeInstances.Count;
        tutorialUsedCpu = computeInstances.Sum(x => x.CpuCores);
