        await LoadDataAsync();
        
        autoRefreshCts = new CancellationTokenSource();
        _ = AutoRefreshLoop(autoRefreshCts.Token);
    }

    private void OnLanguageChanged()
    {
        if (isTutorialActive)
        {
            InitializeTutorialSteps(forceRebuild: true);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TutorialService.ConsumePendingInstancesTutorial())
        {
            await StartInstancesTutorialAsync();
        }
    }

    private async Task AutoRefreshLoop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(10), ct);
                if (!ct.IsCancellationRequested && !ShouldPauseAutoRefresh())
                {
                    await RefreshInstancesOnlyAsync();
                }
            }
            catch (TaskCanceledException) { }
        }
    }

    private bool ShouldPauseAutoRefresh()
        => DateTime.UtcNow < _autoRefreshPausedUntilUtc ||
           _openActionsMenuInstanceIds.Count > 0 ||
           isTutorialActive ||
           _editResourcesOpen ||
           _sshPreviewOpen ||
           isSubmitting ||
            loadingInstanceIds.Count > 0;

    private void PauseAutoRefreshForActionsMenu()
        => _autoRefreshPausedUntilUtc = DateTime.UtcNow.AddSeconds(20);

    private void OnActionsMenuOpenChanged(long instanceId, bool isOpen)
    {
        if (isOpen)
        {
            _openActionsMenuInstanceIds.Add(instanceId);
            PauseAutoRefreshForActionsMenu();
            return;
        }

        _openActionsMenuInstanceIds.Remove(instanceId);
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var quotaTask = ApiClient.GetJsonAsync<UserQuotaDto>("api/users/me/quota");
            var gamesTask = ApiClient.GetJsonAsync<List<GameDefinitionDto>>("api/game-definitions");
            var instancesTask = ApiClient.GetJsonAsync<List<InstanceListItem>>("api/instances");
            Task<AdminProxmoxDashboardDto?>? adminTask = null;
            if (AuthStateService.IsAdmin())
            {
                adminTask = ApiClient.GetJsonAsync<AdminProxmoxDashboardDto>("api/admin/proxmox-dashboard");
            }

            if (adminTask != null)
            {
                await Task.WhenAll(quotaTask, gamesTask, instancesTask, adminTask);
                adminDashboard = adminTask.Result;
            }
            else
            {
                await Task.WhenAll(quotaTask, gamesTask, instancesTask);
            }

            myQuota = quotaTask.Result;
            gameDefinitions = gamesTask.Result ?? [];
            instances = instancesTask.Result ?? [];
            RecalculateUsage();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async void OnInstancesTutorialRequested()
    {
        await InvokeAsync(StartInstancesTutorialAsync);
    }

    private async Task StartInstancesTutorialAsync()
    {
        if (isTutorialActive)
        {
            return;
        }

        for (var i = 0; i < 40 && isLoading; i++)
        {
            await Task.Delay(50);
        }

        if (isLoading)
        {
            return;
        }

        EnsureTutorialData();
        InitializeTutorialSteps(forceRebuild: true);
        isTutorialActive = true;
        tutorialStepIndex = 0;
        _autoRefreshPausedUntilUtc = DateTime.UtcNow.AddMinutes(10);

        tutorialDotNetRef?.Dispose();
        tutorialDotNetRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("playmoxTutorial.start", tutorialDotNetRef);
        await ApplyTutorialStepAsync();
    }

    [JSInvokable]
    public async Task OnTutorialViewportChanged()
    {
        if (!isTutorialActive)
        {
            return;
        }

        await UpdateTutorialLayoutAsync(scrollIntoView: false);
    }

    private async Task ApplyTutorialStepAsync()
    {
        tutorialLayoutCts?.Cancel();
        tutorialLayoutCts = new CancellationTokenSource();
        await UpdateTutorialLayoutAsync(scrollIntoView: true);
    }

    private async Task UpdateTutorialLayoutAsync(bool scrollIntoView)
    {
        if (!isTutorialActive || tutorialSteps.Count == 0)
        {
            return;
        }

        var step = CurrentTutorialStep;
        if (step.RequiresCreateDialog)
        {
            await OpenTutorialCreateDialogAsync();
        }

        if (scrollIntoView)
        {
            await JsRuntime.InvokeVoidAsync("playmoxTutorial.scrollIntoView", step.PrimaryElementId);
        }

        var rects = await FetchTutorialRectsAsync(step.ElementIds);
        if (rects.Count == 0)
        {
            tutorialHighlightStyle = "display:none;";
            tutorialTooltipStyle = "top: 20%; left: 50%; transform: translateX(-50%); width: min(520px, 92vw);";
            StateHasChanged();
            _ = RetryTutorialLayoutAsync(step, 10);
            return;
        }

        var combined = CombineTutorialRects(rects);
        if (step.MinRowCount > 0)
        {
            var rowCount = await JsRuntime.InvokeAsync<int>("playmoxTutorial.getGridRowCount", step.PrimaryElementId);
            if (rowCount < step.MinRowCount)
            {
                tutorialHighlightStyle = "display:none;";
                UpdateTutorialLayout(combined, step.Placement);
                StateHasChanged();
                _ = RetryTutorialLayoutAsync(step, 10);
                return;
            }
        }

        UpdateTutorialLayout(combined, step.Placement);
        StateHasChanged();
    }

    private async Task RetryTutorialLayoutAsync(TutorialStep step, int attempts)
    {
        if (attempts <= 0 || !isTutorialActive)
        {
            return;
        }

        tutorialLayoutCts?.Cancel();
        tutorialLayoutCts = new CancellationTokenSource();
        var ct = tutorialLayoutCts.Token;
        try
        {
            await Task.Delay(200, ct);
            if (ct.IsCancellationRequested || !isTutorialActive)
            {
                return;
            }

            if (step.MinRowCount > 0)
            {
                var rowCount = await JsRuntime.InvokeAsync<int>("playmoxTutorial.getGridRowCount", step.PrimaryElementId);
                if (rowCount < step.MinRowCount)
                {
                    _ = RetryTutorialLayoutAsync(step, attempts - 1);
                    return;
                }
            }

            await UpdateTutorialLayoutAsync(scrollIntoView: false);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task<List<TutorialRect>> FetchTutorialRectsAsync(IReadOnlyList<string> ids)
    {
        var rects = new List<TutorialRect>(ids.Count);
        foreach (var id in ids)
        {
            var rect = await JsRuntime.InvokeAsync<TutorialRect?>("playmoxTutorial.getRect", id);
            if (rect != null)
            {
                rects.Add(rect);
            }
        }
        return rects;
    }

    private static TutorialRect CombineTutorialRects(IReadOnlyList<TutorialRect> rects)
    {
        var left = rects.Min(r => r.Left);
        var top = rects.Min(r => r.Top);
        var right = rects.Max(r => r.Left + r.Width);
        var bottom = rects.Max(r => r.Top + r.Height);
        var first = rects[0];
        return new TutorialRect
        {
            Left = left,
            Top = top,
            Width = Math.Max(1, right - left),
            Height = Math.Max(1, bottom - top),
            ViewportWidth = first.ViewportWidth,
            ViewportHeight = first.ViewportHeight
        };
    }

    private void UpdateTutorialLayout(TutorialRect rect, TutorialPlacement placement)
    {
        const double padding = 8;
        var highlightTop = Math.Max(rect.Top - padding, 8);
        var highlightLeft = Math.Max(rect.Left - padding, 8);
        var highlightWidth = Math.Max(rect.Width + padding * 2, 16);
        var highlightHeight = Math.Max(rect.Height + padding * 2, 16);

        if (highlightLeft + highlightWidth > rect.ViewportWidth - 8)
        {
            highlightWidth = rect.ViewportWidth - highlightLeft - 8;
        }

        if (highlightTop + highlightHeight > rect.ViewportHeight - 8)
        {
            highlightHeight = rect.ViewportHeight - highlightTop - 8;
        }

        tutorialHighlightStyle = $"top:{highlightTop:0}px; left:{highlightLeft:0}px; width:{highlightWidth:0}px; height:{highlightHeight:0}px;";

        var tooltipWidth = Math.Min(420, rect.ViewportWidth - 24);
        const double tooltipHeight = 220;

        double top;
        double left;
        var above = rect.Top - 12;
        var below = rect.ViewportHeight - (rect.Top + rect.Height) - 12;
        var leftSpace = rect.Left - 12;
        var rightSpace = rect.ViewportWidth - (rect.Left + rect.Width) - 12;

        var effectivePlacement = placement == TutorialPlacement.Auto
            ? (below >= tooltipHeight ? TutorialPlacement.Bottom
                : above >= tooltipHeight ? TutorialPlacement.Top
                : rightSpace >= tooltipWidth ? TutorialPlacement.Right
                : TutorialPlacement.Left)
            : placement;

        switch (effectivePlacement)
        {
            case TutorialPlacement.Top:
                top = rect.Top - tooltipHeight - 12;
                left = rect.Left + rect.Width / 2 - tooltipWidth / 2;
                break;
            case TutorialPlacement.Left:
                top = rect.Top + rect.Height / 2 - tooltipHeight / 2;
                left = rect.Left - tooltipWidth - 12;
                break;
            case TutorialPlacement.Right:
                top = rect.Top + rect.Height / 2 - tooltipHeight / 2;
                left = rect.Left + rect.Width + 12;
                break;
            default:
                top = rect.Top + rect.Height + 12;
                left = rect.Left + rect.Width / 2 - tooltipWidth / 2;
                break;
        }

        left = Math.Clamp(left, 12, rect.ViewportWidth - tooltipWidth - 12);
        top = Math.Clamp(top, 12, rect.ViewportHeight - tooltipHeight - 12);

        tutorialTooltipStyle = $"top:{top:0}px; left:{left:0}px; width:{tooltipWidth:0}px;";
    }

    private async Task NextTutorialStep()
    {
        if (!isTutorialActive)
        {
            return;
