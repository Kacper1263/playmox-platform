@page "/instances"
@implements IDisposable
@using System.Text.Json
@using System.Text.RegularExpressions
@using PlaymoxWeb.Models
@using PlaymoxWeb.Services
@using PlaymoxWeb.Extensions
@inject NavigationManager Navigation
@inject AuthStateService AuthStateService
@inject PlaymoxApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TutorialService TutorialService

<PageTitle>@(AuthStateService.IsAdmin() ? L.T(Tr.Instances.PageTitleAdmin) : L.T(Tr.Instances.PageTitleUser))</PageTitle>

@if (!AuthStateService.IsInitialized || isLoading)
{
    <div class="d-flex justify-center align-center" style="height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (!AuthStateService.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning">@L.T(Tr.Common.PleaseLoginFirst)</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" Class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h4" id="tutorial-instances-title">
                @(AuthStateService.IsAdmin() && !isTutorialActive ? L.T(Tr.Nav.AllServers) : L.T(Tr.Nav.MyServers))
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateVmDialog" id="tutorial-create-btn" Disabled="@isTutorialActive">
                @L.T(Tr.Instances.CreateVm)
            </MudButton>
        </MudItem>

        @if (AuthStateService.IsAdmin() && !isTutorialActive)
        {
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-cpu">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.HostCpuCores)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipHostCpu)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedCpu / @(adminDashboard?.CpuCores?.ToString() ?? "—")</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayUsedCpu, adminDashboard?.CpuCores ?? 32)" Value="@DisplayUsedCpu" Max="@(adminDashboard?.CpuCores ?? 32)" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-ram">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.HostRam)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipHostRam)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@FormatBytes(adminDashboard?.MemoryUsedBytes) / @FormatBytes(adminDashboard?.MemoryTotalBytes)</MudText>
                        <MudProgressLinear Color="Color.Info" Value="@(adminDashboard?.MemoryTotalBytes > 0 ? (double)(adminDashboard.MemoryUsedBytes * 100 / adminDashboard.MemoryTotalBytes) : 0)" Max="100" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-instances">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.TotalVms)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipTotalVms)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayActiveInstancesCount VMs</MudText>
                        <MudProgressLinear Color="Color.Primary" Value="100" Max="100" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-disk">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.HostDisk)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipHostDisk)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@FormatBytes(adminDashboard?.RootFsUsedBytes) / @FormatBytes(adminDashboard?.RootFsTotalBytes)</MudText>
                        <MudProgressLinear Color="Color.Warning" Value="@(adminDashboard?.RootFsTotalBytes > 0 ? (double)(adminDashboard.RootFsUsedBytes * 100 / adminDashboard.RootFsTotalBytes) : 0)" Max="100" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-ports">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.PublicPorts)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipHostPorts)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedPublicPorts @L.T(Tr.Instances.ActivePortsSuffix)</MudText>
                        <MudProgressLinear Color="Color.Success" Value="@DisplayUsedPublicPorts" Max="@(Math.Max(DisplayUsedPublicPorts, 10))" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
        else if (DisplayQuota is { } quota)
        {
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-cpu">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.QuotaCpuCores)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipUserCpu)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedCpu / @quota.CpuCoresLimit</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayUsedCpu, quota.CpuCoresLimit)" Value="@DisplayUsedCpu" Max="@quota.CpuCoresLimit" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-ram">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Common.Ram)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipUserRam)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedMemoryMb / @quota.MemoryMbLimit MB</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayUsedMemoryMb, quota.MemoryMbLimit)" Value="@DisplayUsedMemoryMb" Max="@quota.MemoryMbLimit" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-instances">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Home.Instances)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipUserInstances)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayActiveInstancesCount / @quota.MaxInstancesLimit</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayActiveInstancesCount, quota.MaxInstancesLimit)" Value="@DisplayActiveInstancesCount" Max="@quota.MaxInstancesLimit" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-disk">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Common.DiskGb)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipUserDisk)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedDiskGb / @(quota.DiskGbLimit ?? 0) GB</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayUsedDiskGb, quota.DiskGbLimit ?? 100)" Value="@DisplayUsedDiskGb" Max="@(quota.DiskGbLimit ?? 100)" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" lg="2">
                <MudCard Elevation="2" id="tutorial-quota-ports">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2">
                            @L.T(Tr.Instances.PublicPorts)
                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipUserPorts)" />
                        </MudText>
                        <MudText Typo="Typo.h5">@DisplayUsedPublicPorts / @(quota.MaxPublicPortsLimit ?? 0)</MudText>
                        <MudProgressLinear Color="GetQuotaColor(DisplayUsedPublicPorts, quota.MaxPublicPortsLimit ?? 10)" Value="@DisplayUsedPublicPorts" Max="@(quota.MaxPublicPortsLimit ?? 10)" Class="mt-2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDataGrid Items="@DisplayInstances" T="InstanceListItem" Hover="true" Bordered="false" Striped="true" Elevation="2" Class="instances-grid"
                        id="tutorial-vm-grid"
                        QuickFilter="@_quickFilter" Filterable="true" SortMode="SortMode.Multiple"
                        FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L.T(Tr.Instances.MachineList)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="@L.T(Tr.Common.Search)" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                                  id="tutorial-search" Disabled="@isTutorialActive"></MudTextField>
                    
                    <MudCheckBox @bind-Value="showAccessPasswords" Label="@L.T(Tr.Instances.ShowPasswords)" Color="Color.Primary" Disabled="@isTutorialActive" />
                    <MudCheckBox @bind-Value="showDeletedInstances" Label="@L.T(Tr.Instances.ShowDeleted)" Color="Color.Primary" Dense="true" Class="ml-4" Disabled="@isTutorialActive" />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshInstancesOnlyAsync" Disabled="@isTutorialActive" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.VmId" Title="VMID" HeaderStyle="width: 70px; min-width: 65px;" Filterable="false" />
                    @if (AuthStateService.IsAdmin())
                    {
                        <PropertyColumn Property="x => x.OwnerLogin" Title="@L.T(Tr.Instances.Owner)" HeaderStyle="width: 95px; min-width: 90px;">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Item.OwnerLogin) ? $"#{context.Item.OwnerId}" : context.Item.OwnerLogin)</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                    }
                    <PropertyColumn Property='x => (x.VmDisplayName ?? "") + " " + x.GameDisplayName' Title="@L.T(Tr.Instances.GameAndName)" SortBy="x => x.VmDisplayName ?? x.GameDisplayName">
                        <CellTemplate>
                            <div class="d-flex flex-column" style="word-break: break-word;">
                                <MudText Typo="Typo.body2"><b>@(context.Item.VmDisplayName ?? L.TranslateGameName(null, context.Item.GameDisplayName))</b></MudText>
                                @if (!string.IsNullOrEmpty(context.Item.VmDisplayName))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L.TranslateGameName(null, context.Item.GameDisplayName)</MudText>
                                }
                            </div>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Status" Title="@L.T(Tr.Common.Status)" HeaderStyle="width: 135px; min-width: 125px;">
                        <CellTemplate>
                            <div class="d-flex flex-column">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@GetStatusIcon(context.Item.Status)" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small" Class="mr-1" />
                                    <MudText Typo="Typo.body2" Class="text-nowrap">@L.TranslateStatusLabel(context.Item.Status, context.Item.StatusLabel)</MudText>
                                    @if (context.Item.HasPendingJob)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" />
                                    }
                                </div>
                            </div>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CpuCores" Title="@L.T(Tr.Common.Cpu)" HeaderStyle="width: 65px; min-width: 60px;" />
                    <PropertyColumn Property="x => x.MemoryMb" Title="@L.T(Tr.Common.Ram)" HeaderStyle="width: 75px; min-width: 70px;" />
                    <PropertyColumn Property="x => x.DiskGb" Title="@L.T(Tr.Common.DiskGb)" HeaderStyle="width: 90px; min-width: 80px;" />
                    <TemplateColumn Title="@L.T(Tr.Instances.AccessDetails)" HeaderStyle="width: 220px; min-width: 210px;">
                        <CellTemplate>
                            <div class="d-flex flex-column" @attributes="GetTutorialAttributes(context.Item, TutorialAccessId)">
                                @if (!string.IsNullOrEmpty(context.Item.PublicHost))
                                {
                                    <MudText Typo="Typo.caption"><b>@L.T(Tr.Instances.HostLabel):</b> @context.Item.PublicHost</MudText>
                                    @if (context.Item.GamePublicPortStart.HasValue)
                                    {
                                        <MudText Typo="Typo.caption">
                                            <b>@L.T(Tr.Instances.GamePortLabel)</b> @context.Item.GamePublicPortStart
                                            @if (context.Item.GamePublicPortCount > 1)
                                            {
                                                <span>-@(context.Item.GamePublicPortStart + context.Item.GamePublicPortCount - 1)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(context.Item.GamePublicPortProtocol))
                                            {
                                                <span class="mud-text-secondary ml-1">(@context.Item.GamePublicPortProtocol)</span>
                                            }
                                        </MudText>
                                    }
                                    @if (context.Item.SshPublicPort.HasValue)
                                    {
                                        <MudText Typo="Typo.caption">
                                            <b>SSH:</b> @context.Item.AccessUsername : @(showAccessPasswords ? context.Item.AccessPassword : "••••••••")
                                            <HelpTooltip Text="@L.T(Tr.Instances.TooltipSshAccess)" />
                                        </MudText>
                                        <MudText Typo="Typo.caption"><b>@L.T(Tr.Instances.SshPortLabel):</b> @context.Item.SshPublicPort </MudText>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L.T(Tr.Instances.NoLoginCredentials)</MudText>
                                }

                                <div class="mt-2">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" 
                                               OnClick="() => RefreshRuntimeInfoAsync(context.Item.Id)"
                                               Disabled="@(refreshingRuntimeIds.Contains(context.Item.Id) || isTutorialActive)">
                                        @if (refreshingRuntimeIds.Contains(context.Item.Id))
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="mr-2" />
                                        }
                                        @L.T(Tr.Instances.GameStatusButton)
                                    </MudButton>
                                </div>
                                @if (runtimeInfos.TryGetValue(context.Item.Id, out var ri))
                                {
                                    <div class="mt-2 mud-text-secondary" style="font-size: 0.75rem; line-height: 1.2;">
                                        <div><b>@L.T(Tr.Instances.RuntimeStatusLabel)</b> @(ri.IsRunning ? L.T(Tr.Status.Running) : L.T(Tr.Status.Stopped)) <br/> @L.TranslateRuntimeMessage(ri.Message)</div>
                                        @if (ri.IsGamePortListening == true)
                                        {
                                            <div><b>Port @ri.GamePort:</b> @L.T(Tr.Instances.PortListening)</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ri.DetectedServerVersion))
                                        {
                                            <div><b>@L.T(Tr.Instances.VersionLabel)</b> @ri.DetectedServerVersion</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ri.JavaVersion))
                                        {
                                            <div><b>Java:</b> @ri.JavaVersion</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ri.DirectConnectCode))
                                        {
                                            <div><b>Direct Connect:</b> @ri.DirectConnectCode</div>
                                        }
                                        @if (ri.OnlinePlayers.HasValue)
                                        {
                                            <div><b>@L.T(Tr.Instances.PlayersLabel)</b> @ri.OnlinePlayers / @ri.MaxPlayers</div>
                                        }
                                    </div>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L.T(Tr.Instances.LastAction)" HeaderStyle="width: 120px; min-width: 110px;">
                        <CellTemplate>
                            @if (context.Item.LastJobId.HasValue)
                            {
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.caption">#@context.Item.LastJobId (@L.TranslateStatusLabel(context.Item.LastJobStatus, context.Item.LastJobStatusLabel))</MudText>
                                    <MudLink Typo="Typo.caption" OnClick="() => LoadJobsForInstanceAsync(context.Item.Id)">@L.T(Tr.Instances.HistoryLink)</MudLink>
                                </div>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L.T(Tr.Common.Actions)" HeaderStyle="width: 180px; min-width: 175px;" Sortable="false" Filterable="false">
                        <CellTemplate>
                            <div class="d-flex align-center flex-nowrap"
                                 @attributes="GetTutorialAttributes(context.Item, TutorialActionsId)"
                                 @onmouseenter="(_) => PauseAutoRefreshForActionsMenu()"
                                 @onfocusin="(_) => PauseAutoRefreshForActionsMenu()"
                                 @onpointerdown="(_) => PauseAutoRefreshForActionsMenu()">
                                @if (loadingInstanceIds.Contains(context.Item.Id))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-2" />
                                }
                                else
                                {
                                    <MudTooltip Text="@L.T(Tr.Instances.ActionStart)">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small" Class="pa-1"
                                                       OnClick='() => EnqueueLifecycleAsync(context.Item.Id, "start")' 
                                                       Disabled="@(isTutorialActive || isSubmitting || context.Item.HasPendingJob)" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L.T(Tr.Instances.ActionRestart)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" Class="pa-1"
                                                       OnClick='() => EnqueueLifecycleAsync(context.Item.Id, "restart")' 
                                                       Disabled="@(isTutorialActive || isSubmitting || context.Item.HasPendingJob)" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L.T(Tr.Instances.ActionShutdown)">
                                        <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew" Color="Color.Warning" Size="Size.Small" Class="pa-1"
                                                       OnClick='() => EnqueueLifecycleAsync(context.Item.Id, "shutdown")' 
                                                       Disabled="@(isTutorialActive || isSubmitting || context.Item.HasPendingJob)" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L.T(Tr.Instances.ActionForceStop)">
                                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Small" Class="pa-1"
                                                       OnClick="() => ForceStopInstanceAsync(context.Item)" 
                                                       Disabled="@(isTutorialActive || isSubmitting)" />
                                    </MudTooltip>
                                    
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="Size.Small"
                                             Class="pa-1"
                                             Dense="true"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight"
                                             OpenChanged="(isOpen) => OnActionsMenuOpenChanged(context.Item.Id, isOpen)"
                                             Disabled="@isTutorialActive"
                                             @attributes="GetTutorialAttributes(context.Item, TutorialActionsMenuId)">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="() => OpenGameConfigDialog(context.Item)">@L.T(Tr.Instances.MenuGameConfig)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Terminal" OnClick="() => OpenSshPreviewAsync(context.Item.Id, myQuota?.AllowSshPublicPort == true || AuthStateService.IsAdmin())">@L.T(Tr.Instances.MenuConsoleDebug)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Backup" OnClick="() => DownloadGameBackupAsync(context.Item.Id)">@L.T(Tr.Instances.MenuDownloadBackup)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.CloudUpload" OnClick="() => OpenRestoreFilePickerAsync(context.Item.Id)">@L.T(Tr.Instances.MenuRestoreBackup)</MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => BeginEditResources(context.Item)">@L.T(Tr.Instances.MenuEditResources)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" OnClick="() => ReinstallGameAsync(context.Item.Id)">@L.T(Tr.Instances.MenuReinstallGame)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Password" OnClick="() => OpenResetPasswordDialog(context.Item.Id)">@L.T(Tr.Instances.MenuResetSshPassword)</MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteVmAsync(context.Item.Id)">@L.T(Tr.Instances.MenuDeleteVm)</MudMenuItem>
                                    </MudMenu>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="InstanceListItem" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>
    </MudGrid>

    @* Hidden file inputs for restore *@
    @foreach(var instance in instances)
    {
        <InputFile id="@($"restore-file-{instance.Id}")" style="display:none" OnChange="(e) => RestoreGameBackupAsync(instance.Id, e)" />
    }
}

@* SSH Debug Dialog *@
<MudDialog @bind-Visible="_sshPreviewOpen" Options="_sshDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@L.T(Tr.Instances.DebuggingVmTitle, sshPreviewInstanceId)</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="@L.T(Tr.Instances.TabApiCommandStream)" Icon="@Icons.Material.Filled.CastConnected">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@apiCommandStreamMessage</MudAlert>
                <div id="api-command-console" class="ssh-preview-console">@apiCommandStreamOutput</div>
                <MudCheckBox @bind-Value="apiStreamAutoScroll" Label="@L.T(Tr.Instances.AutoScroll)" Dense="true" />
            </MudTabPanel>
            <MudTabPanel Text="@L.T(Tr.Instances.TabSshTerminal)" Icon="@Icons.Material.Filled.Terminal" Disabled="!sshTerminalEnabled">
                @if (sshTerminalEnabled)
                {
                    <MudAlert Severity="@sshPreviewSeverity" Dense="true" Class="mb-2">@sshPreviewMessage</MudAlert>
                    <div id="ssh-terminal-console" class="ssh-preview-console">@sshPreviewOutput</div>
                    <input type="text" placeholder="@L.T(Tr.Instances.TerminalInputPlaceholder)" 
                           class="mt-2 pa-3 w-100" 
                           style="color: var(--mud-palette-text-primary); border: 1px solid var(--mud-palette-lines-default); border-radius: var(--mud-default-borderradius); background: transparent; outline: none;"
                           @onkeydown="OnTerminalKeyDown" 
                           @onkeydown:preventDefault="true" />
                    <MudCheckBox @bind-Value="sshAutoScroll" Label="@L.T(Tr.Instances.AutoScroll)" Dense="true" />
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CloseSshPreview">@L.T(Tr.Common.Close)</MudButton>
    </DialogActions>
</MudDialog>

@* Edit Resources Dialog *@
<MudDialog @bind-Visible="_editResourcesOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">@L.T(Tr.Instances.EditResourcesTitle, _editingVm?.VmId)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="editDisplayName" Label="@L.T(Tr.Instances.DisplayName)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField @bind-Value="editCpuCores" Label="@L.T(Tr.Common.Cpu)" Variant="Variant.Outlined" Min="1" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField @bind-Value="editMemoryMb" Label="@L.T(Tr.Common.RamMb)" Variant="Variant.Outlined" Min="256" Step="256" />
            </MudItem>
            <MudItem xs="4">
