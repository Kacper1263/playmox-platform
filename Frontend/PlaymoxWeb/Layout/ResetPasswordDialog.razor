@using MudBlazor
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L.T(Tr.ResetPassword.DialogTitle)</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@L.T(Tr.ResetPassword.HelperText)</MudText>
        <MudTextField @bind-Value="_newPassword" 
                      Label="@L.T(Tr.ResetPassword.NewPasswordLabel)" 
                      Variant="Variant.Outlined" 
                      InputType="InputType.Password" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L.T(Tr.Common.Cancel)</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@L.T(Tr.ResetPassword.SubmitButton)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    private string _newPassword = string.Empty;

    protected override void OnInitialized()
    {
        L.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void Submit() => MudDialog.Close(DialogResult.Ok(_newPassword));
    private void Cancel() => MudDialog.Cancel();

    public void Dispose()
    {
        L.OnLanguageChanged -= OnLanguageChanged;
    }
}
